{
  "name": "opencodego-dashboard",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Performance observability companion for the OpenCode Console",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && python test/test-userscript.py",
    "capture:readme": "python test/test-userscript.py --capture-readme",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
